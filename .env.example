# Локальная preview-сборка: показывает черновики и запрещает индексацию.
PUBLIC_DEPLOY_ENV=preview
PUBLIC_SITE_URL=https://derevo18.com
# Публичный HTTPS-адрес Yandex Cloud Function для приема заявок.
PUBLIC_FORMS_ENDPOINT=

# Production использует:
# PUBLIC_DEPLOY_ENV=production
# PUBLIC_SITE_URL=https://derevo18.com
# PUBLIC_FORMS_ENDPOINT=https://functions.yandexcloud.net/<function-id>
