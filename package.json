{
  "name": "derevo18-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "assets:sync": "node scripts/download-assets.mjs",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "cross-env PUBLIC_DEPLOY_ENV=preview PUBLIC_SITE_URL=https://derevo18-astro.workers.dev pnpm build",
    "build:production": "cross-env PUBLIC_DEPLOY_ENV=production PUBLIC_SITE_URL=https://derevo18.com pnpm build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:cloudflare": "wrangler dev",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "pnpm build:preview && node scripts/run-e2e.mjs",
    "test:all": "pnpm lint && pnpm test && pnpm test:e2e",
    "deploy": "pnpm build:preview && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "astro": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "cross-env": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "globals": "latest",
    "jsdom": "latest",
    "sharp": "latest",
    "typescript": "^6.0.2",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
