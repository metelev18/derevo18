---
import About from '../components/home/About.astro';
import Catalog from '../components/home/Catalog';
import Director from '../components/home/Director.astro';
import FeedCarousel from '../components/home/FeedCarousel';
import Hero from '../components/home/Hero.astro';
import Portfolio from '../components/home/Portfolio';
import Promo from '../components/home/Promo.astro';
import Technology from '../components/home/Technology.astro';
import VideoSection from '../components/home/VideoSection.astro';
import ContactsSection from '../components/site/ContactsSection';
import { homeContent } from '../data/home';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout seo={homeContent.seo}>
  <Hero />
  <Catalog client:visible />
  <About />
  <Promo />
  <VideoSection />
  <Technology />
  <Director />
  <Portfolio client:visible />
  <FeedCarousel client:visible id="reviews" title="ОТЗЫВЫ" items={homeContent.reviews} />
  <FeedCarousel client:visible id="news" title="НОВОСТИ" items={homeContent.news} />
  <ContactsSection client:visible />
</SiteLayout>
