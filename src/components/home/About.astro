---
import { homeContent } from '../../data/home';

const { about } = homeContent;
---

<section id="about" class="about section-space">
  <div class="about__intro container">
    <div>
      <p class="section-heading__eyebrow">{about.eyebrow}</p>
      <h2>{about.title}</h2>
      <p class="about__lead">{about.lead}</p>
      <h3>{about.servicesTitle}</h3>
      <ul class="service-list">{about.services.map((service) => <li>{service}</li>)}</ul>
      <a class="text-link" href={about.detailsHref}>Подробнее <span aria-hidden="true">→</span></a>
    </div>
    <div class="about__collage" aria-label="Наши работы">
      <img class="about__image about__image--main" src={about.mainImage} alt={about.mainImageAlt} loading="lazy" />
      <img class="about__image about__image--small" src={about.secondaryImage} alt={about.secondaryImageAlt} loading="lazy" />
      <div class="about__badge"><strong>{about.badgeTitle}</strong><span>{about.badgeText}</span></div>
    </div>
  </div>
  <div class="feature-strip container">
    {about.features.map((feature) => <article><strong>{feature.title}</strong><span>{feature.text}</span></article>)}
  </div>
</section>
