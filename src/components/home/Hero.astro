---
import { homeContent } from '../../data/home';
---

<section id="top" class="hero" style={`background-image: linear-gradient(0deg, rgba(0,0,0,.88), rgba(0,0,0,0) 68%), url(${homeContent.hero.background})`}>
  <div class="hero__inner container">
    <div class="hero__title-block">
      <p>{homeContent.hero.eyebrow}</p>
      <h1>{homeContent.hero.title}</h1>
    </div>
    <div class="hero__actions">
      <button class="button button--accent button--large" type="button" data-lead-form="catalog">Скачать каталог</button>
      <a class="button button--outline button--large" href="/coming-soon/?target=calculator">Рассчитать стоимость</a>
    </div>
    <div class="hero__materials">
      {homeContent.hero.materials.map((material) => (
        <a href="/coming-soon/?target=material" class="material-link">
          <img src={material.image} width="54" height="54" alt="" />
          <span>{material.title}</span>
        </a>
      ))}
    </div>
  </div>
</section>
