---
import { homeContent } from '../../data/home';

const { director } = homeContent;
---

<section class="director section-space">
  <div class="director__inner container">
    <img src={director.image} alt={director.imageAlt} loading="lazy" />
    <div>
      <blockquote>{director.quote}</blockquote>
      <p>{director.text}</p>
      <strong>{director.name}</strong>
      <span>{director.role}</span>
    </div>
  </div>
</section>
