---
import { homeContent } from '../../data/home';

const { video } = homeContent;
---

<section class="video-section section-space container" aria-label={video.title}>
  <div class="video-frame">
    <iframe src={video.src} title={video.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen></iframe>
  </div>
</section>
