---
import { homeContent } from '../../data/home';

const { promo } = homeContent;
---

<section class="promo" style={`background-image: linear-gradient(90deg, rgba(24,15,8,.84), rgba(24,15,8,.22)), url(${promo.background})`}>
  <div class="promo__grid container">
    {promo.cards.map((card) => (
      <article><p>{card.eyebrow}</p><h2>{card.title}</h2><a class="button button--outline" href={card.href}>{card.button}</a></article>
    ))}
  </div>
</section>
