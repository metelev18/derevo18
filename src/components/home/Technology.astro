---
import { homeContent } from '../../data/home';

const { technology } = homeContent;
---

<section id="technology" class="technology section-space">
  <div class="technology__inner container">
    <div class="technology__photo"><img src={technology.image} alt={technology.imageAlt} loading="lazy" /></div>
    <div>
      <p class="section-heading__eyebrow">{technology.eyebrow}</p>
      <h2>{technology.title}</h2>
      <ol>{technology.items.map((item) => <li><span>{item.number}</span><p>{item.text}</p></li>)}</ol>
    </div>
  </div>
</section>
