---
import type { SeoSettings } from '../data/site';
import { isProductionDeploy } from '../lib/deployment';
import '../styles/global.css';

interface Props {
  seo: SeoSettings;
  bodyClass?: string;
}

const { seo, bodyClass } = Astro.props;
const productionDeploy = isProductionDeploy(import.meta.env.PUBLIC_DEPLOY_ENV);
const allowIndexing = productionDeploy && !seo.noindex;
const siteUrl = Astro.site ?? new URL('https://derevo18-astro.workers.dev');
const canonicalUrl = new URL(seo.canonicalPath, siteUrl).toString();
const ogImage = new URL(seo.ogImage, siteUrl).toString();
const analyticsEnabled = productionDeploy && import.meta.env.PROD;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={allowIndexing ? 'index, follow' : 'noindex, nofollow'} />
    <meta name="description" content={seo.description} />
    <meta name="theme-color" content="#96ce5a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{seo.title}</title>
    {analyticsEnabled && (
      <script is:inline>
        {`if (!window.__derevoAnalyticsLoaded) {
          window.__derevoAnalyticsLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function(){window.dataLayer.push(arguments);};
          window.gtag('js', new Date());
          window.gtag('config', 'G-PG0SDVJEDX');
          var gtagScript = document.createElement('script');
          gtagScript.async = true;
          gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-PG0SDVJEDX';
          document.head.appendChild(gtagScript);
          setTimeout(function(){
            (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t);a=e.getElementsByTagName(t)[0];k.async=1;k.src=r;a.parentNode.insertBefore(k,a);})(window,document,'script','https://mc.yandex.ru/metrika/tag.js','ym');
            window.ym(48718478,'init',{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true,ecommerce:'dataLayer'});
          }, 2000);
          setTimeout(function(){
            (function(i,s,o,g,r,a,m){i.GoogleAnalyticsObject=r;i[r]=i[r]||function(){(i[r].q=i[r].q||[]).push(arguments)};i[r].l=1*new Date();a=s.createElement(o);m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m);})(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
            window.ga('create','333879943','auto');window.ga('send','pageview');
          }, 2000);
        }`}
      </script>
    )}
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
